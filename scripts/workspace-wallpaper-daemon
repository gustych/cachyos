#!/bin/bash

# Workspace Wallpaper Daemon
# Listens for workspace changes and sets wallpapers accordingly

CONFIG_FILE="$HOME/.config/hypr/workspace-wallpapers.json"
WALLPAPER_DIR="$HOME/Pictures/Wallpapers"

if [ ! -f "$CONFIG_FILE" ]; then
    echo "Error: Config file not found at $CONFIG_FILE"
    exit 1
fi

# Get wallpaper for workspace
get_wallpaper() {
    local workspace=$1
    jq -r ".\"$workspace\" // \"default.png\"" "$CONFIG_FILE" 2>/dev/null
}

# Set wallpaper
set_wallpaper() {
    local file="$1"
    if [ -f "$WALLPAPER_DIR/$file" ]; then
        swww img "$WALLPAPER_DIR/$file" --transition-type fade --transition-duration 1
    fi
}

# Get current workspace
get_current_workspace() {
    hyprctl activeworkspace -j 2>/dev/null | jq -r '.id' 2>/dev/null
}

# Monitor workspace changes
echo "Starting workspace wallpaper daemon..."
socat -U - UNIX-CONNECT:"$XDG_RUNTIME_DIR/hypr/$HYPRLAND_INSTANCE_SIGNATURE/.socket2.sock" | while read -r event; do
    if [[ $event == workspace* ]]; then
        workspace=$(echo "$event" | grep -oP 'workspace>>\K[0-9]+' || echo "")
        if [ -n "$workspace" ]; then
            wallpaper=$(get_wallpaper "$workspace")
            echo "Workspace $workspace -> $wallpaper"
            set_wallpaper "$wallpaper"
        fi
    fi
done
